{
  "name": "@dnbhq/browserslist-config",
  "description": "Shared Browserslist configuration for @davidsneighbour's projects.",
  "version": "0.1.4",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsneighbour/browserslist-config.git"
  },
  "author": "Patrick Kollitsch <davidsneighbourdev+gh@gmail.com> (https://davids-neighbour.com)",
  "bugs": "https://github.com/davidsneighbour/browserslist-config/issues",
  "homepage": "https://github.com/davidsneighbour/browserslist-config#readme",
  "dependencies": {
    "browserslist": "4.28.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@dnbhq/biome-config": "0.2.3",
    "@dnbhq/tsconfig": "0.1.6",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/node": "26.4.1",
    "lint-staged": "17.4.1",
    "release-it": "21.0.2",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check": "biome check",
    "lint": "biome lint",
    "lint:staged": "lint-staged",
    "prepare": "simple-git-hooks",
    "release": "release-it --ci",
    "release:dry": "release-it --dry-run",
    "test": "npm run check"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "full.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=25"
  },
  "exports": {
    ".": "./index.js",
    "./full": "./full.js",
    "./full.js": "./full.js"
  },
  "lint-staged": {
    "*.{js,json,ts}": "biome check --write --no-errors-on-unmatched"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "type": "module"
}
